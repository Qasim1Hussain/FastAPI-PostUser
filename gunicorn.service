[Unit]
Description=Gunicorn instance to serve api
After=network.target

[Service]
User=qasim
Group=qasim
WorkingDirectory=/home/qasim/app/src/
Environment="PATH=/home/qasim/app/venv/bin"
EnvironmentFile=/home/qasim/app/.env
ExecStart=/home/qasim/app/venv/bin/gunicorn --workers 4 -k uvicorn.workers.UvicornWorker app.main:app -b 0.0.0.0:8000

[Install]
WantedBy=multi-user.target